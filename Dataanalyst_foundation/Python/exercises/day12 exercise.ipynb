    "\n",
    "ValueError\n",
    "ZeroDivisionError\n",
    "\n",
    "Examples:\n",
    "\n",
    "10\n",
    "2\n",
    "\n",
    "Output:\n",
    "\n",
    "5.0"
   ]
  },
  {
